{
    "name": "programming-course-docs",
    "private": true,
    "scripts": {
        "prepare": "husky",
        "format": "prettier --write . && node scripts/normalize-html-void-elements.mjs --write",
        "format:check": "node scripts/verify-prettier-normalized-formatting.mjs && node scripts/normalize-html-void-elements.mjs --check",
        "lint:md": "markdownlint **/*.mdx **/*.md --ignore AGENTS.md --ignore node_modules/** --ignore agent-rules-private/**",
        "lint:md:fix": "npm run lint:md -- --fix",
        "verify": "npm run format:check && node scripts/verify-normalize-html-void-elements.mjs && node scripts/verify-prettier-embedded-formatting.mjs && node scripts/verify-code-block-indentation.mjs && node scripts/verify-exercise-headings.mjs && npm run lint:md"
    },
    "devDependencies": {
        "husky": "^9.0.11",
        "lint-staged": "^15.2.2",
        "markdownlint-cli": "^0.39.0",
        "prettier": "3.6.2"
    },
    "lint-staged": {
        "*.{md,mdx,html}": [
            "prettier --write",
            "node scripts/normalize-html-void-elements.mjs --write"
        ],
        "*.{json,yml,yaml,css,js,ts}": "prettier --write",
        "*.{md,mdx}": "markdownlint --fix --ignore AGENTS.md --ignore node_modules/** --ignore agent-rules-private/**"
    }
}
