{
  "name": "programming-course-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind",
    "lint": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx src/components/submissions/__tests__/*.test.ts scripts/__tests__/*.test.ts",
    "test:e2e": "node scripts/run-playwright-e2e.mjs",
    "test:e2e:inner": "playwright test",
    "setup:git-hooks": "node scripts/setup-git-hooks.mjs"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "@metyatech/code-preview": "github:metyatech/code-preview",
    "@metyatech/exercise": "github:metyatech/exercise-module",
    "@re-dev/react-truncate": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "lucide-react": "^0.563.0",
    "next": "^15.5.9",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "pagefind": "^1.4.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
